<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sounding Tangki Texturing</title>
  <style>
    :root {
      --primary: #0f766e;
      --primary-dark: #115e59;
      --bg: #f1f5f9;
      --card: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --accent-bg: #ccfbf1;
      --warn-bg: #fef3c7;
      --warn-text: #92400e;
      --border: #cbd5e1;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
    body { background: var(--bg); color: var(--text); padding-bottom: 40px; }
    header {
      background: var(--primary);
      color: #fff;
      padding: 16px;
      position: sticky;
      top: 0;
      z-index: 10;
      box-shadow: 0 2px 6px rgba(0,0,0,0.12);
    }
    header h1 { font-size: 18px; font-weight: 700; }
    header p { font-size: 12px; opacity: 0.9; margin-top: 2px; }
    .tabs {
      display: flex;
      background: #fff;
      border-bottom: 1px solid var(--border);
    }
    .tab-btn {
      flex: 1;
      padding: 12px;
      border: none;
      background: none;
      font-weight: 600;
      font-size: 14px;
      color: var(--muted);
      cursor: pointer;
      border-bottom: 3px solid transparent;
    }
    .tab-btn.active {
      color: var(--primary);
      border-bottom-color: var(--primary);
      background: #f0fdfa;
    }
    .container { max-width: 640px; margin: 16px auto; padding: 0 14px; }
    .card {
      background: var(--card);
      border-radius: 12px;
      padding: 16px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.06);
      margin-bottom: 14px;
      border: 1px solid #e2e8f0;
    }
    .form-group { margin-bottom: 12px; }
    label { display: block; font-size: 12px; font-weight: 600; color: var(--muted); margin-bottom: 4px; }
    select, input {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 15px;
      background: #fff;
      color: var(--text);
    }
    .row-2 { display: grid; grid-template-columns: 1.4fr 1fr; gap: 10px; }
    .result-box {
      background: var(--accent-bg);
      border: 1px solid #5eead4;
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 12px;
    }
    .result-title { font-size: 12px; font-weight: 700; color: var(--primary-dark); text-transform: uppercase; text-align: center; letter-spacing: 0.5px; }
    .main-metrics {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin: 12px 0;
      text-align: center;
    }
    .metric-card {
      background: #fff;
      padding: 10px;
      border-radius: 10px;
      border: 1px solid #99f6e4;
    }
    .metric-label { font-size: 11px; color: var(--muted); }
    .metric-val { font-size: 20px; font-weight: 800; color: var(--primary-dark); margin-top: 2px; }
    .detail-list { font-size: 12.5px; border-top: 1px solid #99f6e4; padding-top: 10px; }
    .detail-row { display: flex; justify-content: space-between; padding: 3px 0; gap: 8px; }
    .detail-row span:last-child { font-weight: 600; text-align: right; }
    .warn-box {
      background: var(--warn-bg);
      color: var(--warn-text);
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 12.5px;
      margin-bottom: 12px;
      border: 1px solid #fcd34d;
    }
    .btn-row { display: flex; gap: 8px; }
    button.primary {
      flex: 1;
      background: var(--primary);
      color: #fff;
      border: none;
      padding: 12px 16px;
      border-radius: 8px;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
    }
    button.secondary {
      background: #fff;
      color: var(--primary);
      border: 1px solid var(--primary);
      padding: 12px 14px;
      border-radius: 8px;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
    }
    button.export-btn {
      background: #e2e8f0;
      color: var(--text);
      border: none;
      padding: 8px 12px;
      border-radius: 8px;
      font-weight: 700;
      font-size: 12.5px;
      cursor: pointer;
    }
    .log-item {
      border-bottom: 1px solid #e2e8f0;
      padding: 12px 0;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 10px;
    }
    .log-item:last-child { border-bottom: none; }
    .log-title { font-weight: 700; font-size: 14px; }
    .log-meta { font-size: 12px; color: var(--muted); margin-top: 3px; line-height: 1.4; }
    .log-stock { font-size: 13px; font-weight: 700; color: var(--primary-dark); margin-top: 3px; }
    .del-btn {
      background: #fee2e2;
      color: #b91c1c;
      border: none;
      padding: 6px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
    }
    .toast {
      position: fixed;
      bottom: 18px;
      left: 50%;
      transform: translateX(-50%);
      background: #0f172a;
      color: #fff;
      padding: 10px 16px;
      border-radius: 8px;
      font-size: 13px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s;
      z-index: 99;
    }
    .toast.show { opacity: 1; }
  </style>
</head>
<body>
  <header>
    <h1>Sounding Tangki Texturing</h1>
    <p>Kalkulator Volume &amp; Tonase Offline (Tabel Kalibrasi &amp; Density)</p>
  </header>

  <div class="tabs">
    <button class="tab-btn active" id="tabCalcBtn" onclick="switchTab('calc')">Hitung Sounding</button>
    <button class="tab-btn" id="tabLogBtn" onclick="switchTab('log')">Riwayat &amp; Rekap (<span id="logCount">0</span>)</button>
  </div>

  <div class="container">
    <!-- TAB 1 -->
    <div id="calcTab">
      <div class="card">
        <div class="form-group">
          <label for="shiftSelect">Shift</label>
          <select id="shiftSelect">
            <option value="Shift 1 (Pagi)">Shift 1 (Pagi)</option>
            <option value="Shift 2 (Sore)">Shift 2 (Sore)</option>
            <option value="Shift 3 (Malam)">Shift 3 (Malam)</option>
          </select>
        </div>

        <div class="form-group">
          <label for="tankSelect">Nomor Tangki</label>
          <select id="tankSelect" onchange="onTankChange()"></select>
        </div>

        <div class="form-group">
          <label for="productSelect">Jenis Produk / Minyak</label>
          <select id="productSelect" onchange="recalculate()"></select>
        </div>

        <div class="row-2">
          <div class="form-group">
            <label for="soundingInput">Sounding Level (cm)</label>
            <input type="number" step="0.1" id="soundingInput" placeholder="Contoh: 401 atau 729.7" oninput="recalculate()" />
          </div>
          <div class="form-group">
            <label for="tempInput">Suhu (&deg;C)</label>
            <input type="number" step="0.1" id="tempInput" value="30" oninput="recalculate()" />
          </div>
        </div>
      </div>

      <div id="warningBox" class="warn-box" style="display:none;"></div>

      <div id="resultCard" class="result-box" style="display:none;">
        <div class="result-title">Hasil Perhitungan Stok</div>
        <div class="main-metrics">
          <div class="metric-card">
            <div class="metric-label">Total Stock (kg)</div>
            <div class="metric-val" id="resStockKg">0 kg</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">Tonase (MT)</div>
            <div class="metric-val" id="resStockTon">0.000 Ton</div>
          </div>
        </div>
        <div class="detail-list" id="detailRows"></div>
      </div>

      <div id="actionButtons" class="btn-row" style="display:none;">
        <button class="primary" onclick="saveLog()">Simpan ke Riwayat</button>
        <button class="secondary" onclick="copyResult()">Salin WA</button>
      </div>

      <div id="emptyHint" class="card" style="text-align:center; color:var(--muted); font-size:13.5px;">
        Masukkan angka <b>Sounding Level (cm)</b> untuk melihat hasil perhitungan otomatis.
      </div>
    </div>

    <!-- TAB 2 -->
    <div id="logTab" style="display:none;">
      <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; gap:8px; margin-bottom:10px;">
          <div>
            <div style="font-size:12px; color:var(--muted);">Total Stok Tercatat</div>
            <div style="font-size:16px; font-weight:800; color:var(--primary-dark);" id="totalRecordedTon">0.000 Ton</div>
          </div>
          <button class="export-btn" onclick="exportCsv()">Export CSV</button>
        </div>
        <div id="logListContainer">
          <p style="text-align:center; color:var(--muted); font-size:13px; padding:16px 0;">Belum ada catatan sounding tersimpan.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

