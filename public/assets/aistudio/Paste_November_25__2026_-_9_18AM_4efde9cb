      }
      if (tank.tRef === 30) {
        document.getElementById('tempInput').value = '30';
      }
      recalculate();
    }

    function recalculate() {
      const idx = parseInt(document.getElementById('tankSelect').value, 10);
      const tank = CALIBRATION_DATA.tanks[idx];
      const product = document.getElementById('productSelect').value;
      const sRaw = document.getElementById('soundingInput').value.replace(',', '.');
      const tRaw = document.getElementById('tempInput').value.replace(',', '.');

      const sounding = parseFloat(sRaw);
      const temp = parseFloat(tRaw);

      if (isNaN(sounding) || isNaN(temp)) {
        currentCalc = null;
        document.getElementById('resultCard').style.display = 'none';
        document.getElementById('actionButtons').style.display = 'none';
        document.getElementById('warningBox').style.display = 'none';
        document.getElementById('emptyHint').style.display = 'block';
        return;
      }

      const highLevel = sounding + tank.tableLevel;
      const tableObj = CALIBRATION_DATA.calibrationTables[tank.calTable] || {};
      const entries = tableObj.entries || {};

      let baseVol = 0;
      let diffPerCm = 0;
      let baseHeight = 0;
      let fractionCm = 0;
      let warnings = [];

      if (highLevel < 0) {
        warnings.push(`High Level negatif (${highLevel.toFixed(2)} cm), volume dianggap 0 L.`);
      } else {
        baseHeight = Math.floor(highLevel);
        fractionCm = highLevel - baseHeight;

        if (Object.prototype.hasOwnProperty.call(entries, String(baseHeight))) {
          const pair = entries[String(baseHeight)];
          baseVol = Number(pair[0] || 0);
          diffPerCm = Number(pair[1] || 0);
        } else {
          const keys = Object.keys(entries).map(Number).sort((a, b) => a - b);
          if (keys.length > 0) {
            if (baseHeight < keys[0]) {
              warnings.push(`Tinggi di bawah batas minimum tabel kalibrasi (${keys[0]} cm).`);
            } else {
              let matched = keys[0];
              for (const k of keys) {
                if (k <= baseHeight) matched = k;
                else break;
              }
              const pair = entries[String(matched)];
              baseVol = Number(pair[0] || 0);
              diffPerCm = Number(pair[1] || 0);
              if (baseHeight > keys[keys.length - 1]) {
                warnings.push(`Tinggi melebihi batas maksimum tabel (${keys[keys.length - 1]} cm).`);
              }
            }
          }
        }
      }

      const fractionVol = fractionCm * diffPerCm;
      const totalVol = baseVol + fractionVol;

      const prodDensities = CALIBRATION_DATA.densityTable[product] || {};
      const tempInt = Math.floor(temp);
      let density = 0;
      if (Object.prototype.hasOwnProperty.call(prodDensities, String(tempInt))) {
        density = Number(prodDensities[String(tempInt)]);
      } else {
        const tKeys = Object.keys(prodDensities).map(Number).sort((a, b) => a - b);
        if (tKeys.length > 0) {
          let nearest = tKeys[0];
          for (const tk of tKeys) {
            if (tk <= tempInt) nearest = tk;
            else break;
          }
          density = Number(prodDensities[String(nearest)]);
          warnings.push(`Suhu ${tempInt}°C memakai density suhu terdekat (${nearest}°C).`);
        }
      }

      const vcf = ((temp - tank.tRef) * 0.0000348) + 1.0;
      const stockKg = Math.round(totalVol * vcf * density);
      const stockTon = stockKg / 1000.0;

      currentCalc = {
        shift: document.getElementById('shiftSelect').value,
        tankId: tank.id,
        product,
        sounding,
        tableLevel: tank.tableLevel,
        highLevel,
        baseHeight,
        baseVol,
        fractionCm,
        diffPerCm,
        fractionVol,
        totalVol,
        temp,
        tRef: tank.tRef,
        vcf,
        density,
        stockKg,
        stockTon,
        timestamp: new Date().toISOString()
      };

      const warnEl = document.getElementById('warningBox');
      if (warnings.length > 0) {
        warnEl.textContent = warnings.join(' ');
        warnEl.style.display = 'block';
      } else {
        warnEl.style.display = 'none';
      }

      document.getElementById('emptyHint').style.display = 'none';
      document.getElementById('resultCard').style.display = 'block';
      document.getElementById('actionButtons').style.display = 'flex';

      document.getElementById('resStockKg').textContent = `${stockKg.toLocaleString('id-ID')} kg`;
      document.getElementById('resStockTon').textContent = `${stockTon.toFixed(3)} Ton`;

      document.getElementById('detailRows').innerHTML = `
        <div class="detail-row"><span>High Level (Cm)</span><span>${highLevel.toFixed(2)} cm (${sounding} + ${tank.tableLevel})</span></div>
        <div class="detail-row"><span>Volume Tabel (${baseHeight} cm)</span><span>${baseVol.toLocaleString('id-ID')} L</span></div>
        <div class="detail-row"><span>Pecahan (${fractionCm.toFixed(2)} × ${diffPerCm})</span><span>+${fractionVol.toFixed(2)} L</span></div>
        <div class="detail-row"><span>Total Volume</span><span>${totalVol.toFixed(2)} L</span></div>
        <div class="detail-row"><span>Density (${temp}°C)</span><span>${density.toFixed(4)}</span></div>
        <div class="detail-row"><span>VCF (Ref ${tank.tRef}°C)</span><span>${vcf.toFixed(7)}</span></div>
      `;
    }

    function saveLog() {
      if (!currentCalc) return;
      const entry = { ...currentCalc, shift: document.getElementById('shiftSelect').value, id: String(Date.now()) };
      logs.unshift(entry);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(logs));
      document.getElementById('logCount').textContent = logs.length;
      showToast(`Tersimpan: ${entry.tankId} (${entry.stockKg} kg)`);
    }

    function copyResult() {
      if (!currentCalc) return;
      const r = currentCalc;
      const txt = `${r.tankId} | ${r.product} | Sounding: ${r.sounding} cm | High: ${r.highLevel.toFixed(2)} cm | Suhu: ${r.temp}°C | Vol: ${r.totalVol.toFixed(1)} L | Stok: ${r.stockKg} kg (${r.stockTon.toFixed(3)} Ton)`;
      navigator.clipboard?.writeText(txt);
      showToast('Hasil disalin ke clipboard (siap paste ke WA)');
    }

    function deleteLog(id) {
      logs = logs.filter(item => item.id !== id);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(logs));
      document.getElementById('logCount').textContent = logs.length;
      renderLogs();
    }

    function renderLogs() {
      const container = document.getElementById('logListContainer');
      const totalKg = logs.reduce((acc, item) => acc + (Number(item.stockKg) || 0), 0);
      document.getElementById('totalRecordedTon').textContent = `${(totalKg / 1000).toFixed(3)} Ton (${logs.length} item)`;

      if (logs.length === 0) {
        container.innerHTML = '<p style="text-align:center; color:var(--muted); font-size:13px; padding:16px 0;">Belum ada catatan sounding tersimpan.</p>';
        return;
      }

      container.innerHTML = logs.map(item => {
        const dt = new Date(item.timestamp);
        const timeStr = isNaN(dt.getTime()) ? item.timestamp : dt.toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' });
        return `
          <div class="log-item">
            <div>
              <div class="log-title">${item.tankId} &bull; ${item.product}</div>
              <div class="log-meta">${timeStr} (${item.shift})<br/>Sounding: ${item.sounding} cm (High: ${Number(item.highLevel).toFixed(1)} cm) &bull; Suhu: ${item.temp}°C &bull; Vol: ${Number(item.totalVol).toFixed(1)} L</div>
              <div class="log-stock">Stok: ${Number(item.stockKg).toLocaleString('id-ID')} kg (${(Number(item.stockKg)/1000).toFixed(3)} Ton)</div>
            </div>
            <button class="del-btn" onclick="deleteLog('${item.id}')">Hapus</button>
          </div>
        `;
      }).join('');
    }

    function exportCsv() {
      if (logs.length === 0) {
        showToast('Belum ada data untuk di-export');
        return;
      }
      const headers = ['Waktu,Shift,Tangki,Produk,Sounding_Cm,Table_Level_Cm,High_Level_Cm,Temp_C,Volume_Liter,Density,VCF,Total_Stock_Kg,Total_Stock_Ton'];
      const rows = logs.map(l => [
        l.timestamp,
        `"${l.shift}"`,
        l.tankId,
        `"${l.product}"`,
        l.sounding,
        l.tableLevel,
        Number(l.highLevel).toFixed(2),
        l.temp,
        Number(l.totalVol).toFixed(2),
        l.density,
        Number(l.vcf).toFixed(7),
        l.stockKg,
        (Number(l.stockKg) / 1000).toFixed(3)
      ].join(','));
      const csvStr = [headers.join(','), ...rows].join('
');
      const blob = new Blob([csvStr], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'rekap_sounding_tangki.csv';
      a.click();
      URL.revokeObjectURL(url);
      showToast('File CSV berhasil diunduh');
    }

    initApp();
  </script>
</body>
